{
  "schema": 1,
  "id": "red-war-first-mission.prototype",
  "title": "Red War first mission host-capability prototype",
  "provenance": "authored-prototype",
  "start": "configure-destination",
  "parameters": {
    "activityPackage": "mission_towerfall",
    "activityBubble": "0",
    "activitySliceSet": "0",
    "arrivalBubbleHash": "0xF28FC859",
    "spawnSetHash": "0x811C9DC5",
    "objectiveDefinitionHash": "0x00000000",
    "enemyActorDefinitionHash": "0x00000000",
    "enemyCount": "3"
  },
  "nodes": [
    {
      "id": "configure-destination",
      "trigger": {
        "type": "host.start"
      },
      "actions": [
        {
          "type": "command",
          "capability": "activity.override.configure",
          "payload": {
            "enabled": true,
            "packageName": "${activityPackage}",
            "bubble": "${activityBubble}",
            "sliceSet": "${activitySliceSet}"
          }
        },
        {
          "type": "log",
          "message": "Configured process-local destination ${activityPackage}, bubble ${activityBubble}, slice set ${activitySliceSet}; spawn remains client-selected."
        }
      ],
      "next": "wait-for-destination"
    },
    {
      "id": "wait-for-destination",
      "trigger": {
        "type": "world.phase",
        "value": "arrived"
      },
      "actions": [
        {
          "type": "log",
          "message": "Destination arrived. Beginning the authored Red War capability probe."
        }
      ],
      "next": "open-objective"
    },
    {
      "id": "open-objective",
      "trigger": {
        "type": "delay",
        "milliseconds": 500
      },
      "actions": [
        {
          "type": "command",
          "capability": "objective.set",
          "payload": {
            "definitionHash": "${objectiveDefinitionHash}",
            "state": "active",
            "progress": 0
          }
        }
      ],
      "next": "spawn-first-wave"
    },
    {
      "id": "spawn-first-wave",
      "trigger": {
        "type": "immediate"
      },
      "actions": [
        {
          "type": "command",
          "capability": "entity.spawn",
          "payload": {
            "activityPackage": "${activityPackage}",
            "arrivalBubbleHash": "${arrivalBubbleHash}",
            "spawnSetHash": "${spawnSetHash}",
            "actorDefinitionHash": "${enemyActorDefinitionHash}",
            "count": "${enemyCount}",
            "ownership": "activity-host",
            "despawnPolicy": "on-node-exit"
          }
        }
      ],
      "next": "wait-for-wave-clear"
    },
    {
      "id": "wait-for-wave-clear",
      "trigger": {
        "type": "signal",
        "value": "wave.cleared"
      },
      "actions": [
        {
          "type": "command",
          "capability": "objective.set",
          "payload": {
            "definitionHash": "${objectiveDefinitionHash}",
            "state": "complete",
            "progress": 1
          }
        },
        {
          "type": "log",
          "message": "Prototype encounter complete. Add the next verified mission node rather than guessing hidden host policy."
        }
      ]
    }
  ]
}
