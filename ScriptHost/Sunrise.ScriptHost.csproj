<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Sunrise.ScriptHost</RootNamespace>
    <AssemblyName>Sunrise.ScriptHost</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <None Update="bindings\**\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="scripts\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
